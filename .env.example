# CareFlow Docker Compose configuration.
# Copy this file to .env for `docker compose` commands. Do not commit .env.

CAREFLOW_VERSION=0.4.8

# Only used by docker-compose.deploy.yml. Replace these placeholders with
# images that your team has built, scanned, and published.
CAREFLOW_BACKEND_IMAGE=ghcr.io/your-org/careflow-backend
CAREFLOW_FRONTEND_IMAGE=ghcr.io/your-org/careflow-frontend

APP_HOST=0.0.0.0
APP_PORT=8000
DATA_DIR=/app/data
ASSET_DIR=/app/data/asset
DATABASE_URL=sqlite:////app/data/careflow.db
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080
STORE_AI_RAW_RESPONSES=false

# Leave keys blank to use CareFlow's mock-mode fallbacks.
LLM_PROVIDER=auto

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-v4-flash

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=careflow-gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_MODEL=gpt-5-mini

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_ASR_MODEL=fun-asr
